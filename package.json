{
  "name": "my-pact",
  "version": "0.60.6",
  "description": "자녀의 로블록스 시간을 관리하는 Electron 타이머 앱",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:win": "npm run package:win:signed",
    "package:win:unsigned": "electron-vite build && electron-builder --win --x64 --config.win.signAndEditExecutable=false --config.win.forceCodeSigning=false",
    "package:win:signed": "node scripts/ensure-win-signing-configured.mjs && electron-vite build && electron-builder --win --x64 --config electron-builder.config.cjs && node scripts/verify-win-signature.mjs",
    "verify:win-signature": "node scripts/verify-win-signature.mjs",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.mypact.myfuture",
    "productName": "My Pact",
    "executableName": "My Pact",
    "icon": "resources/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "My Pact",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "My Pact"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-256.png"
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  }
}
