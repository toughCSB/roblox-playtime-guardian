{
  "name": "my-pact",
  "version": "0.50.0",
  "description": "자녀의 로블록스 시간을 관리하는 Electron 타이머 앱",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:win": "electron-vite build && electron-builder --win --x64 --config.win.signAndEditExecutable=false",
    "package:win:signed": "electron-vite build && electron-builder --win --x64",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.mypact.myfuture",
    "productName": "My Pact",
    "executableName": "My Pact",
    "icon": "resources/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "My Pact",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "My Pact"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-256.png"
    }
  },
  "dependencies": {
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
